# Copy to `.env` and adjust. These override inference_engine/config.py defaults.
# (Load them in your shell, e.g. `set -a; source .env; set +a`, or via VSCode.)

# ── Model ─────────────────────────────────────────────────────────────────────
# Any HuggingFace causal-LM id. Default: Qwen/Qwen2-0.5B
#MODEL_NAME=Qwen/Qwen2-0.5B

# ── Hardware: auto-detected (cuda > mps > cpu) ────────────────────────────────
#DEVICE=mps

# ── Server ────────────────────────────────────────────────────────────────────
#HOST=127.0.0.1
#PORT=8001

# ── Scheduler / batching ──────────────────────────────────────────────────────
#MAX_BATCH_SIZE=4
#PREFILL_BUDGET_TOKENS=512
#DECODE_BATCH_LIMIT=8
#PREFILL_CHUNK_SIZE=128
#REQUEST_TIMEOUT_MS=30000

# ── Paged KV cache ────────────────────────────────────────────────────────────
#KV_BLOCK_SIZE=16
#KV_NUM_BLOCKS=256
#KV_NUM_CPU_BLOCKS=128

# ── Metrics ───────────────────────────────────────────────────────────────────
#METRICS_OUTPUT_PATH=baseline_metrics.json
